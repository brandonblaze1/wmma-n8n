      "notes": "Only with WMMA in the name\n"
    },
    {
      "parameters": {
        "jsCode": "const workflow = $json;\n\nconst slug = workflow.name\n  .replace(/^WMMA\\s*(\\/|-|:)?\\s*/i, '')\n  .toLowerCase()\n  .replace(/[^a-z0-9]+/g, '-')\n  .replace(/^-+|-+$/g, '') || workflow.id;\n\nconst basePath = `n8n/workflows/${slug}`;\n\nreturn [{\n  json: {\n    workflow_id: workflow.id,\n    workflow_name: workflow.name,\n    slug,\n\n    base_path: basePath,\n\n    workflow_path: `${basePath}/workflow.json`,\n    readme_path: `${basePath}/README.md`,\n\n    workflow_json: JSON.stringify(workflow, null, 2),\n\n    readme_prompt: `\nCreate a professional GitHub README.md for this n8n workflow.\n\nWorkflow Name:\n${workflow.name}\n\nRequirements:\n- Explain what the workflow does\n- Explain trigger behavior\n- Explain integrations/services used\n- Mention credentials likely required\n- Include setup/import instructions\n- Include operational notes and warnings\n- Keep formatting GitHub friendly\n- Keep tone practical and technical\n\nWorkflow JSON:\n${JSON.stringify(workflow, null, 2)}\n`\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
